{
  "name": "nexustreasury",
  "version": "1.0.0",
  "private": true,
  "description": "NexusTreasury \u2014 Cloud-Native Treasury Management Platform",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "infra:apply": "cd infra && kubectl apply -k kubernetes/overlays/production",
    "infra:staging": "cd infra && kubectl apply -k kubernetes/overlays/staging",
    "db:migrate": "prisma migrate dev",
    "db:seed": "turbo run db:seed",
    "db:generate": "prisma generate",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prisma": "^5.9.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@stryker-mutator/typescript-checker": "^8.6.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@prisma/client": "^5.9.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "pnpm": {
    "overrides": {
      "fast-jwt": ">=6.3.4",
      "next": ">=15.5.16",
      "esbuild": ">=0.28.1",
      "@babel/core": ">=7.29.6",
      "postcss-selector-parser": ">=6.1.3",
      "@grpc/grpc-js": ">=1.14.5",
      "express": ">=4.21.2",
      "follow-redirects": ">=1.15.6",
      "ip": ">=2.0.1",
      "micromatch": ">=4.0.8",
      "semver": ">=7.6.3",
      "fastify": ">=5.12.5",
      "fast-uri": ">=3.1.8",
      "brace-expansion": ">=5.0.12",
      "cookie": ">=0.7.0",
      "path-to-regexp": ">=0.1.12",
      "protobufjs": ">=7.5.5",
      "@fastify/static": ">=10.1.2",
      "postcss": ">=8.5.23",
      "@opentelemetry/core": ">=2.8.0",
      "baseline-browser-mapping": ">=2.11.0",
      "d3-color": ">=3.1.0",
      "cookie-signature": ">=1.0.6",
      "object-path": ">=0.11.8",
      "tar": ">=7.4.3",
      "dompurify": ">=3.2.4",
      "send": ">=0.19.0",
      "json-schema": ">=0.4.0",
      "glob": ">=10.4.5",
      "ws": ">=8.20.1",
      "source-map-js": ">=1.2.2",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "fast-xml-parser": ">=5.7.0",
      "socket.io-parser": ">=4.2.7",
      "browserslist": ">=4.28.7",
      "braces": ">=3.0.3"
    }
  }
}
