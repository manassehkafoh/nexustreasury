{
  "name": "nexustreasury",
  "version": "1.0.0",
  "private": true,
  "description": "NexusTreasury \u2014 Cloud-Native Treasury Management Platform",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "infra:apply": "cd infra && kubectl apply -k kubernetes/overlays/production",
    "infra:staging": "cd infra && kubectl apply -k kubernetes/overlays/staging",
    "db:migrate": "prisma migrate dev",
    "db:seed": "turbo run db:seed",
    "db:generate": "prisma generate",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/typescript-checker": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "prisma": "^5.9.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@prisma/client": "^5.9.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "pnpm": {
    "overrides": {
      "fast-jwt": ">=6.3.4",
      "@babel/core": ">=7.29.6",
      "@fastify/static": ">=10.1.2",
      "@grpc/grpc-js": ">=1.14.5",
      "@opentelemetry/core": ">=2.8.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@protobufjs/utf8": ">=1.1.1",
      "baseline-browser-mapping": ">=2.11.0",
      "brace-expansion": "1.1.11",
      "browserslist": ">=4.28.7",
      "esbuild": ">=0.28.1",
      "fast-uri": ">=3.1.8",
      "fast-xml-builder": ">=1.1.7",
      "fast-xml-parser": ">=5.7.0",
      "fastify": ">=5.12.5",
      "find-my-way": ">=9.7.0",
      "nanoid": ">=3.3.18",
      "next": ">=15.5.27",
      "postcss": ">=8.5.23",
      "postcss-selector-parser": ">=7.1.6",
      "protobufjs": ">=7.6.5",
      "sharp": ">=0.35.5",
      "socket.io-parser": ">=4.2.7",
      "source-map-js": ">=1.2.2",
      "ws": ">=8.21.0",
      "minimatch": "3.1.2"
    }
  }
}
