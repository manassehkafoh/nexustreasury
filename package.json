{
  "name": "nexustreasury",
  "version": "1.0.0",
  "private": true,
  "description": "NexusTreasury — Cloud-Native Treasury Management Platform",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "infra:apply": "cd infra && kubectl apply -k kubernetes/overlays/production",
    "infra:staging": "cd infra && kubectl apply -k kubernetes/overlays/staging",
    "db:migrate": "prisma migrate dev",
    "db:seed": "turbo run db:seed",
    "db:generate": "prisma generate",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "pnpm": {
    "overrides": {
      "fast-jwt": ">=6.2.0",
      "postcss": ">=8.5.18",
      "next": ">=15.5.28",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "sharp": ">=0.35.5",
      "@fastify/static": ">=10.1.1",
      "@opentelemetry/core": ">=2.8.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "zod": ">=4.6.6",
      "minimatch": ">=11.0.1",
      "glob": ">=14.0.2"
    }
  }
}